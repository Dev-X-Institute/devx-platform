{
  "name": "devx-platform",
  "private": true,
  "version": "0.1.0",
  "description": "DevX Solutions monorepo: all apps and shared packages",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx only-allow npm",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:education": "npm run dev -w education-web"
  },
  "devDependencies": {
    "@types/node": "26.6.7",
    "only-allow": "1.2.2",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  }
}
